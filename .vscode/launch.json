{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Harness",
            "type": "debugpy",
            "request": "launch",
            "module": "harness_example.main",
            "stopOnEntry": true,
            "subProcess": true,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONUTF8": "1"
            },
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            }
        },
        {
            "name": "Debug Agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/pydantic_agent_example/main.py",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONUTF8": "1"
            },
            "stopOnEntry": true
        }
    ]
}
